<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>PCareer.Client</AssemblyName>
    <RootNamespace>PCareer.Client</RootNamespace>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <Version>1.0.0</Version>
    <AssemblyName>VirtualPilotNetwork</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(SimConnectAssemblyPath)')">
    <DefineConstants>$(DefineConstants);SIMCONNECT_AVAILABLE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <DefineConstants>$(DefineConstants);SINGLE_FILE_PUBLISH</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(SimConnectAssemblyPath)')">
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>$(SimConnectAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="Exists('$(SimConnectNativePath)')">
    <Content Include="$(SimConnectNativePath)">
      <Link>SimConnect.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" ExcludeAssets="build" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>PCareer.Client.LogicTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Target Name="RemoveXmlDocs" AfterTargets="Publish">
    <Delete Files="$(PublishDir)*.xml" />
  </Target>
</Project>
